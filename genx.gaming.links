<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Genx Gaming — Links</title>
<style>
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    padding: 20px;
    box-sizing: border-box;
  }
  .card {
    background: #ffffff;
    border-radius: 20px;
    padding: 36px 30px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.25);
    text-align: center;
    max-width: 360px;
    width: 100%;
  }
  h1 {
    font-size: 22px;
    margin: 0 0 6px;
    color: #262626;
  }
  p.sub {
    font-size: 13px;
    color: #737373;
    margin: 0 0 24px;
  }
  a.btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    padding: 14px 18px;
    border-radius: 12px;
    margin-bottom: 14px;
    transition: transform 0.1s ease;
  }
  a.btn:active { transform: scale(0.98); }
  .insta {
    background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045);
    color: white;
  }
  .fb {
    background: #1877f2;
    color: white;
  }
</style>
</head>
<body>
  <div class="card">
    <h1>Genx Gaming</h1>
    <p class="sub">Find me on social media</p>
    <a class="btn insta" href="https://www.instagram.com/genx.gaming7?igsh=NDl5ajZjdTNrNW90" target="_blank">📸 Instagram</a>
    <a class="btn fb" href="https://www.facebook.com/share/181ZLMFAke/" target="_blank">👍 Facebook</a>
  </div>
</body>
</html>
